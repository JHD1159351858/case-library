diff --git a/src/lib/whitelist-admin-token.ts b/src/lib/whitelist-admin-token.ts
new file mode 100644
--- /dev/null
+++ b/src/lib/whitelist-admin-token.ts
@@ -0,0 +1,48 @@
+import { createHash, timingSafeEqual } from 'node:crypto';
+
+export interface WhitelistAdminTokenInput {
+  expectedToken: string | null | undefined;
+  authorizationHeader: string | null | undefined;
+  actorHeader: string | null | undefined;
+  reservedTokens?: Array<string | null | undefined>;
+}
+
+const MIN_TOKEN_LENGTH = 32;
+const MAX_ACTOR_LENGTH = 128;
+const MAX_ACTOR_HEADER_LENGTH = 1536;
+const VISIBLE_ASCII = /^[\x21-\x7e]+$/u;
+const ASCII = /^[\x00-\x7f]*$/u;
+const CONTROL_CHARACTERS = /[\u0000-\u001f\u007f-\u009f]/u;
+
+function sha256(value: string): Buffer {
+  return createHash('sha256').update(value, 'utf8').digest();
+}
+
+export function authenticateWhitelistAdminToken({
+  expectedToken,
+  authorizationHeader,
+  actorHeader,
+  reservedTokens = [],
+}: WhitelistAdminTokenInput): string | null {
+  const configuredToken = expectedToken?.trim() ?? '';
+  if (configuredToken.length < MIN_TOKEN_LENGTH || !VISIBLE_ASCII.test(configuredToken) || !authorizationHeader) {
+    return null;
+  }
+  if (reservedTokens.some((value) => {
+    const reserved = value?.trim() ?? '';
+    return reserved !== '' && reserved === configuredToken;
+  })) return null;
+
+  const match = /^Bearer[ \t]+(\S+)$/iu.exec(authorizationHeader.trim());
+  if (!match || !timingSafeEqual(sha256(match[1]), sha256(configuredToken))) return null;
+
+  if (!actorHeader || actorHeader.length > MAX_ACTOR_HEADER_LENGTH || !ASCII.test(actorHeader)) return null;
+  let actor: string;
+  try {
+    actor = decodeURIComponent(actorHeader).trim();
+  } catch {
+    return null;
+  }
+  if (!actor || Array.from(actor).length > MAX_ACTOR_LENGTH || CONTROL_CHARACTERS.test(actor)) return null;
+  return `case-library:${actor}`;
+}
diff --git a/tests/whitelist-admin-token.test.mjs b/tests/whitelist-admin-token.test.mjs
new file mode 100644
--- /dev/null
+++ b/tests/whitelist-admin-token.test.mjs
@@ -0,0 +1,87 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { authenticateWhitelistAdminToken } from '../src/lib/whitelist-admin-token.ts';
+
+const TOKEN = 'whitelist-admin-token-0123456789abcdef';
+
+function authenticate(overrides = {}) {
+  return authenticateWhitelistAdminToken({
+    expectedToken: TOKEN,
+    authorizationHeader: `Bearer ${TOKEN}`,
+    actorHeader: 'u-case-admin',
+    ...overrides,
+  });
+}
+
+test('白名单集成令牌：正确 Bearer 返回带来源前缀的审计 actor', () => {
+  assert.equal(authenticate(), 'case-library:u-case-admin');
+  assert.equal(
+    authenticate({
+      expectedToken: `  ${TOKEN}  `,
+      authorizationHeader: `bearer ${TOKEN}`,
+      actorHeader: encodeURIComponent('  管理员-甲🙂  '),
+    }),
+    'case-library:管理员-甲🙂',
+  );
+});
+
+test('白名单集成令牌：缺失、过短、错误或畸形令牌均拒绝', () => {
+  for (const expectedToken of [undefined, null, '', 'x'.repeat(31)]) {
+    assert.equal(authenticate({ expectedToken }), null);
+  }
+  const nonAsciiToken = `令牌${'x'.repeat(32)}`;
+  assert.equal(authenticate({
+    expectedToken: nonAsciiToken,
+    authorizationHeader: `Bearer ${nonAsciiToken}`,
+  }), null);
+  for (const authorizationHeader of [
+    undefined,
+    null,
+    '',
+    TOKEN,
+    'Basic abc',
+    'Bearer',
+    `Bearer wrong-${TOKEN}`,
+    `Bearer ${TOKEN} trailing`,
+  ]) {
+    assert.equal(authenticate({ authorizationHeader }), null);
+  }
+});
+
+test('白名单集成令牌：不能使用 SSO 共享密钥代替独立令牌', () => {
+  const ssoSharedSecret = 'sso-shared-secret-0123456789abcdef';
+  assert.equal(authenticate({ authorizationHeader: `Bearer ${ssoSharedSecret}` }), null);
+});
+
+test('白名单集成令牌：配置值与任一旧密钥相同则关闭，空值和不同密钥不影响', () => {
+  assert.equal(authenticate({ reservedTokens: [`  ${TOKEN}  `] }), null);
+  assert.equal(authenticate({ reservedTokens: ['different-secret', TOKEN] }), null);
+  assert.equal(authenticate({ reservedTokens: [undefined, null, '', '   ', 'different-secret'] }), 'case-library:u-case-admin');
+});
+
+test('白名单集成令牌：actor header 必须是可解码的 ASCII，解码后校验真实 UID', () => {
+  for (const actorHeader of [
+    undefined,
+    null,
+    '',
+    '   ',
+    'x'.repeat(129),
+    'x'.repeat(1537),
+    '中文🙂',
+    '%E4%B8%AD%',
+    'uid%0Asuffix',
+    'uid%7Fsuffix',
+    'uid%C2%85suffix',
+    'uid\u0000suffix',
+    'uid\nsuffix',
+    'uid\u007fsuffix',
+    'uid\u0085suffix',
+  ]) {
+    assert.equal(authenticate({ actorHeader }), null);
+  }
+  assert.equal(
+    authenticate({ actorHeader: encodeURIComponent('🙂'.repeat(128)) }),
+    `case-library:${'🙂'.repeat(128)}`,
+  );
+});
