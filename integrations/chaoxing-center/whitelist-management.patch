+export function requireWhitelistAdminOr401(request: NextRequest): string | null {
+  const username = requireAdminOr401(request);
+  if (username) return username;
+  return authenticateWhitelistAdminToken({
+    expectedToken: process.env.SSO_WHITELIST_ADMIN_TOKEN,
+    authorizationHeader: request.headers.get('authorization'),
+    actorHeader: request.headers.get('x-case-library-actor'),
+    reservedTokens: [
+      process.env.SSO_SHARED_SECRET,
+      process.env.ADMIN_PASSWORD,
+      process.env.ADMIN_SESSION_SECRET,
+    ],
+  });
+}
