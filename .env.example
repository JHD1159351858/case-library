# ============================================================================
# agent-official-website 配置模板
# 复制为 .env 后填写实际值：cp .env.example .env
# ============================================================================

# 后端服务端口（2001-3000 区间，本项目登记 2001）
BACKEND_PORT=2001
BACKEND_HOST=127.0.0.1

# 本站对外地址（SSO 回调与 return_to 白名单都基于此 origin）
APP_PUBLIC_URL=http://127.0.0.1:2001

# 超星 SSO 统一认证中心地址（不带结尾斜杠）
SSO_CENTER_URL=https://your-sso-center.example.com

# 与认证中心共享的验票密钥（从认证中心侧 .env 的 SSO_SHARED_SECRET 复制）
SSO_SHARED_SECRET=your-shared-secret

# return_to 白名单 origin（逗号分隔；默认兜底仅允许 APP_PUBLIC_URL 自身）
# 本地联调是 http://127.0.0.1:2001；线上部署时改为线上域名
SSO_ALLOWED_RETURN_ORIGINS=http://127.0.0.1:2001

# 管理员判定：role / roles 命中清单（大小写不敏感，逗号分隔）
ADMIN_ROLES=admin

# 管理员判定兜底：认证中心 uid 清单（逗号分隔，留空表示不启用）
ADMIN_SSO_UIDS=

# ----------------------------------------------------------------------------
# 数据库（二选一）
# 1) 生产/持久化：配置 PostgreSQL 连接串（平台托管数据库），数据跨重启保留。
#    配置后优先使用 PG，DB_PATH 被忽略。生产环境请通过平台环境变量/Secret 注入，
#    不要把真实连接串写进仓库或本地 .env。
#    连接串需带 SSL 与通道绑定参数，例如：
#    DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&channel_binding=require
# DATABASE_URL=
#
# 2) 本地/兜底：留空 DATABASE_URL 时使用内置 SQLite（零外部依赖）。
#    相对路径相对项目根目录，运行时自动创建。
DB_PATH=database/agent-website.db

# 封面上传目录（生产环境项目目录只读时由 start-cloud.mjs 自动重定向到 /tmp）
# UPLOADS_DIR=database/uploads

# 前端静态目录（默认 project/frontend，一般无需修改）
# FRONTEND_DIR=project/frontend

# 对话查找使用扣子国内版；密钥仅由后端读取，两项齐全后启用
COZE_API_TOKEN=
COZE_BOT_ID=
